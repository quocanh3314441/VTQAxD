-- Logic
local function banUnit(unitName)
    pcall(function()
        game:GetService("ReplicatedStorage"):WaitForChild("RemoteEvents"):WaitForChild("BanFromUnitBox"):FireServer(boxId, unitName, true)
        print("✓ Banned from greenhouse box: " .. unitName)
    end)
end

local function banAll()
    for _, name in ipairs(unwantedUnits) do
        banUnit(name)
        task.wait(0.5)
    end
    print("All unwanted units banned from astral summon box!")
end

local function rollBox()
    pcall(function()
        local args = { "ub_astral_summon", 10 }
        game:GetService("ReplicatedStorage"):WaitForChild("RemoteFunctions"):WaitForChild("BuyUnitBox"):InvokeServer(unpack(args))
        rollCount += 1
        rollCountLabel.Text = "Rolls: " .. rollCount
        print("✓ Roll #" .. rollCount .. " - Attempting to buy astral summon box (10x)")
    end)
end

local function startAutoRoll()
    task.spawn(function()
        while autoRollEnabled do
            rollBox()
            task.wait(1)
        end
    end)
end

-- Auto-start
banAll()
startAutoRoll()
print("Auto ban and roll Mango Cluster enabled!")

stopButton.MouseButton1Click:Connect(function()
    autoRollEnabled = false
    controlFrame.Visible = false
    rollCount = 0
    print("Auto roll stopped!")
end)

print("Script loaded - Greenhouse Box roller ready")
print("3D Rendering disabled")
print("Anti-AFK enabled")
