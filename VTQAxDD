-- Get current cash
local function getCash()
    local cashDisplay = game:GetService("Players").LocalPlayer.PlayerGui.GameGui.Screen.Bottom.CurrencyDisplay.Cash
    if cashDisplay then
        local cashText = cashDisplay.Text or ""
        print("Cash text: " .. cashText)  -- Debug: see what the text looks like
        
        -- Remove commas and any non-digit characters except the number
        local cleanText = string.gsub(cashText, "[^0-9]", "")
        local cashValue = tonumber(cleanText) or 0
        
        print("Cleaned text: " .. cleanText .. " | Final value: " .. cashValue)  -- Debug output
        return cashValue
    end
    return 0
end

-- Randomize position by ±5% of X and Z (not based on distanceAlongPath)
local function randomizePosition(config)
    local x = config.position.X
    local y = config.position.Y
    local z = config.position.Z

    local xOffset = (math.random() - 0.5) * 0.10 * math.abs(x) -- ±5% of X
    local zOffset = (math.random() - 0.5) * 0.10 * math.abs(z) -- ±5% of Z

    local newPos = vector.create(x + xOffset, y, z + zOffset)
    -- Use the original CFrame's rotation, but new position
    local _, _, _, r00, r01, r02, r10, r11, r12, r20, r21, r22 = config.cf:GetComponents()
    local newCF = CFrame.new(newPos.X, newPos.Y, newPos.Z, r00, r01, r02, r10, r11, r12, r20, r21, r22)

    return {
        Valid = true,
        PathIndex = config.pathIndex,
        Position = newPos,
        DistanceAlongPath = config.distanceAlongPath,
        CF = newCF,
        Rotation = config.rotation
    }
end

