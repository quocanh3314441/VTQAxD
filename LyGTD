local placementRandom = Random.new()
local placementRandomization = {distanceScale = 0.10, xOffset = 1.5, zOffset = 1.5}

local function getPlacedUnitCount()
    local player = Players.LocalPlayer
    if not player then return 0 end
    local units = player:FindFirstChild("PlayerGui")
    if units then units = units:FindFirstChild("GameGui") end
    if units then units = units:FindFirstChild("Screen") end
    if units then units = units:FindFirstChild("Bottom") end
    if units then units = units:FindFirstChild("Units") end
    if units and (units:IsA("TextLabel") or units:IsA("TextButton")) then
        local text = units.Text
        local placed = text:match("^(%d+)%s*/%s*%d+")
        return tonumber(placed) or 0
    end
    return 0
end

local function randomizePlacement(config)
    local baseDistance = config.distanceAlongPath
    local distanceOffset = placementRandom:NextNumber(-0.5, 0.5) * placementRandomization.distanceScale * baseDistance
    local xOffset = placementRandom:NextNumber(-placementRandomization.xOffset, placementRandomization.xOffset)
    local zOffset = placementRandom:NextNumber(-placementRandomization.zOffset, placementRandomization.zOffset)
    local positionOffset = Vector3.new(xOffset, 0, zOffset)
    return {
        Valid = true,
        PathIndex = config.pathIndex,
        Position = config.position + positionOffset,
        DistanceAlongPath = baseDistance + distanceOffset,
        CF = config.cf + positionOffset,
        Rotation = config.rotation
    }
end

