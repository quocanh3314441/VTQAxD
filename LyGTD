-- ==================== FIRESIGNAL CLICK FUNCTION ====================
local function clickButton(btn)
    if not btn then
        print("❌ [CLICK] Button is nil - GUI path wrong?")
        return false
    end

    print("🔍 [CLICK] Attempting to click button:", btn.Name or "Unknown")

    local clicked = false

    -- Primary Method: firesignal on MouseButton1Click
    if btn.MouseButton1Click then
        local ok, err = pcall(function()
            firesignal(btn.MouseButton1Click)
        end)
        if ok then
            print("✅ [CLICK] SUCCESS - Used firesignal(MouseButton1Click) on", btn.Name)
            clicked = true
        else
            print("⚠️ [CLICK] firesignal(MouseButton1Click) failed:", err)
        end
    end

    -- Secondary Method: firesignal on Activated
    if not clicked and btn.Activated then
        local ok, err = pcall(function()
            firesignal(btn.Activated)
        end)
        if ok then
            print("✅ [CLICK] SUCCESS - Used firesignal(Activated) on", btn.Name)
            clicked = true
        else
            print("⚠️ [CLICK] firesignal(Activated) failed:", err)
        end
    end

    -- Fallback: Try multiple firesignal attempts
    if not clicked then
        local signals = {"Touched", "InputBegan", "InputEnded"}
        for _, signalName in ipairs(signals) do
            if not clicked and btn:FindFirstChild(signalName) then
                local ok, err = pcall(function()
                    firesignal(btn[signalName])
                end)
                if ok then
                    print("✅ [CLICK] SUCCESS - Used firesignal(" .. signalName .. ") on", btn.Name)
                    clicked = true
                    break
                end
            end
        end
    end

    if not clicked then
        print("❌ [CLICK] firesignal methods failed for", btn.Name)
    end

    return clicked
end

