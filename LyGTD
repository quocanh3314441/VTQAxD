-- Get the number of placed Rafflesias using the Units label's Text property
local function getPlacedRafflesiaCount()
    local player = Players.LocalPlayer
    if not player then return 0 end
    local units = player:FindFirstChild("PlayerGui")
    if units then
        units = units:FindFirstChild("GameGui")
    end
    if units then
        units = units:FindFirstChild("Screen")
    end
    if units then
        units = units:FindFirstChild("Bottom")
    end
    if units then
        units = units:FindFirstChild("Units")
    end

    if units and (units:IsA("TextLabel") or units:IsA("TextButton")) then
        local text = units.Text
        -- Try to match "Rafflesia: X/Y" or fallback to the first number
        local placed = text:match("Rafflesia:%s*(%d+)%s*/%s*%d+") or text:match("^(%d+)%s*/%s*%d+")
        return tonumber(placed) or 0
    end
    return 0
end

-- Randomize position by ±5% of X and Z for Rafflesia
local function randomizeRafflesiaPosition(config)
    local x = config.position.X
    local y = config.position.Y
    local z = config.position.Z
    local xOffset = (math.random() - 0.5) * 0.10 * math.abs(x)
    local zOffset = (math.random() - 0.5) * 0.10 * math.abs(z)
    local newX = x + xOffset
    local newZ = z + zOffset
    local newPos = vector.create(newX, y, newZ)
    local _, _, _, r00, r01, r02, r10, r11, r12, r20, r21, r22 = config.cf:GetComponents()
    local newCF = CFrame.new(newX, y, newZ, r00, r01, r02, r10, r11, r12, r20, r21, r22)
    return {
        Valid = true,
        PathIndex = config.id,
        Position = newPos,
        DistanceAlongPath = config.DistanceAlongPath,
        CF = newCF,
        Rotation = config.rotation
    }
end

