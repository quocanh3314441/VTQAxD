        local currentUnits = tonumber(string.match(cleanText, "^(%d+)"))
        if not currentUnits and cleanText ~= "" then
            currentUnits = tonumber(cleanText)
        end
        return currentUnits
    end
    return nil
end

local function clickButton(btn)
    if not btn then return false end
    local clicked = false
    if btn.MouseButton1Click then pcall(function() firesignal(btn.MouseButton1Click) clicked=true end) end
    if not clicked and btn.Activated then pcall(function() firesignal(btn.Activated) clicked=true end) end
    if not clicked then
        for _, s in ipairs({"Touched", "InputBegan", "InputEnded"}) do
            if btn:FindFirstChild(s) then pcall(function() firesignal(btn[s]) clicked=true end); break end
        end
    end
    return clicked
end

