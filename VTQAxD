local function readAutoSkipState()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return nil end

    local ok, grad = pcall(function()
        return pg.GameGuiNoInset.Screen.Top.WaveControls.WaveControls.AutoSkip.UIGradient
    end)
    if not ok or not grad then return nil end

    local kps = grad.Color.Keypoints
    if #kps == 0 then return nil end
    local c = kps[1].Value

    if math.abs(c.R - 0.45098) < 0.01
       and math.abs(c.G - 0.901961) < 0.01
       and c.B < 0.01 then
        return true
    end
    if math.abs(c.R - 1) < 0.01
       and math.abs(c.G - 0.666667) < 0.01
       and c.B < 0.01 then
        return false
    end
    return nil
end

