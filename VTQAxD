                            print("🏆 Match finished (Units Cleared)!")
                        end
                        initiateAggressiveRestart()
                        return
                    end

                    if currentUnits >= targetUnitCount then
                        setupCompletedThisRound = true

                        -- Toggle AutoUpgradeAll exactly once per round.
                        if not hasToggledAutoUpgrade then
                            if not cache.ui.autoUpgradeAllBtn then refreshUICache() end
                            local btn = cache.ui.autoUpgradeAllBtn
                            if btn and btn.Parent then
                                if clickButton(btn) then
                                    hasToggledAutoUpgrade = true
                                    print("[AutoUpgrade] AutoUpgradeAll toggled ON (13 units placed)")
                                end
                            end
                        end
                        return
                    end

                    local targetUnit = halloweenSequence[currentUnits]
                    if targetUnit then
                        quickMoveToDestination(targetUnit.X, targetUnit.Y + 2, targetUnit.Z)
                        adaptiveWait(0.06)

                        if not cache.ui.hotbarItems then refreshUICache() end
                        if cache.ui.hotbarItems then
                            local card = cache.ui.hotbarItems:FindFirstChild(targetUnit.Name)
                                     or cache.ui.hotbarItems:FindFirstChild(targetUnit.UI_Name)
                            if card then
                                clickButton(card)
                                adaptiveWait(0.02)
                            end
                        end

                        if not cache.remotes.placeUnit then refreshRemoteCache() end
                        if cache.remotes.placeUnit then
                            -- Inner pcall so placement failures are visible (outer pcall swallows them otherwise).
                            local placedOk, cfgOrErr = pcall(function()
                                local cfg = getRandomizedConfig(targetUnit)
                                cache.remotes.placeUnit:InvokeServer(targetUnit.Name, cfg)
                                return cfg
                            end)

                            if placedOk then
                                local p = cfgOrErr and cfgOrErr.Position or placeConfig.Position
                                print(string.format(
                                    "[Unit %d/%d] Placed %s at (%.2f, %.2f, %.2f)",
                                    currentUnits + 1, targetUnitCount,
                                    targetUnit.UI_Name,
                                    p and p.X or targetUnit.X,
                                    p and p.Y or targetUnit.Y,
                                    p and p.Z or targetUnit.Z
                                ))
                            else
                                warn(string.format(
                                    "[Unit %d/%d] FAILED to place %s — error: %s",
                                    currentUnits + 1, targetUnitCount,
                                    targetUnit.UI_Name, tostring(cfgOrErr)
                                ))
                            end
                        else
                            warn(string.format(
                                "[Unit %d/%d] SKIPPED %s — placeUnit remote missing",
                                currentUnits + 1, targetUnitCount, targetUnit.UI_Name
                            ))
                        end
                        adaptiveWait(0.12)
                    end
                end)
            end
            adaptiveWait(0.18)
        end
    end)
end

