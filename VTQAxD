local placementRandom = Random.new()
local function getRandomizedConfig(unitData)
    local m = unitData.RotMatrix

    -- 5% Position Variation applied to all units
    local xVar = math.abs(unitData.X) * 0.05
    local zVar = math.abs(unitData.Z) * 0.05
    
    local fX = unitData.X + placementRandom:NextNumber(-xVar, xVar)
    local fY = unitData.Y
    local fZ = unitData.Z + placementRandom:NextNumber(-zVar, zVar)
    
    return {
        CF = CFrame.new(fX, fY, fZ, m[1], m[2], m[3], m[4], m[5], m[6], m[7], m[8], m[9]), 
        Rotation = 180, 
        Valid = true, 
        WasFastPlaced = true,
        Position = vector.create(fX, fY, fZ)
    }
end

