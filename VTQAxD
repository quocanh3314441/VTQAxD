-- ==================== FIRESIGNAL CLICK ENGINE ====================
local function clickButton(btn)
    if not btn then return false end
    local clicked = false

    if btn.MouseButton1Click then
        local ok, err = pcall(function() firesignal(btn.MouseButton1Click) end)
        if ok then clicked = true end
    end

    if not clicked and btn.Activated then
        local ok, err = pcall(function() firesignal(btn.Activated) end)
        if ok then clicked = true end
    end

    if not clicked then
        local signals = {"Touched", "InputBegan", "InputEnded"}
        for _, signalName in ipairs(signals) do
            if not clicked and btn:FindFirstChild(signalName) then
                local ok, err = pcall(function() firesignal(btn[signalName]) end)
                if ok then clicked = true; break end
            end
        end
    end

    return clicked
end

