local placementRandom = Random.new()

local function getRandomizedConfig(unitData)
    local xVar = math.abs(unitData.X) * 0.05
    local yVar = math.abs(unitData.Y) * 0.05
    local zVar = math.abs(unitData.Z) * 0.05

    local finalX = unitData.X + placementRandom:NextNumber(-xVar, xVar)
    local finalY = unitData.Y + placementRandom:NextNumber(-yVar, yVar)
    local finalZ = unitData.Z + placementRandom:NextNumber(-zVar, zVar)

    return {
        CF = CFrame.new(finalX, finalY, finalZ, -1, 0, -8.742277657347586e-08, 0, 1, 0, 8.742277657347586e-08, 0, -1),
        Rotation = 180,
        Valid = true,
        Position = vector.create(finalX, finalY, finalZ)
    }
end

