-- UI-BASED JOIN MAP LOGIC (Optimized for speed)
if autojoinmap then
    task.spawn(function()
        local function waitForPathFast(root, pathList)
            local current = root
            for _, childName in ipairs(pathList) do
                if not current then return nil end
                local success, child = pcall(function() return current:WaitForChild(childName, 2) end)
                if success and child then
                    current = child
                else
                    return nil
                end
            end
            return current
        end

        local function teleportTo(pos)
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.CFrame = CFrame.new(pos)
            end
        end

        -- Check if we are near the pad AND if we are the ONLY player there
        local function isAloneOnPad()
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not hrp then return false end

            -- Must be within 10 studs of the pad first
            if (hrp.Position - JOIN_PAD_POS).Magnitude > 10 then
                return false
            end

            -- Check for other players within 5 studs of the pad
            local params = OverlapParams.new()
            params.FilterType = Enum.RaycastFilterType.Exclude
            params.FilterDescendantsInstances = {char}

            local parts = workspace:GetPartBoundsInRadius(JOIN_PAD_POS, 5, params)
            for _, part in ipairs(parts) do
                local model = part:FindFirstAncestorOfClass("Model")
                if model then
                    local player = Players:GetPlayerFromCharacter(model)
                    if player and player ~= LocalPlayer then
                        return false -- Another player is here
                    end
                end
            end

            return true -- No other players found within 5 studs
        end

        while autojoinmap do
            if game.PlaceId == LOBBY_PLACE_ID then

                -- 1. Teleport to Join Pad
                teleportTo(JOIN_PAD_POS)
                print("📍 Teleported to Join Pad.")

                -- Wait just a brief moment for character to settle
                task.wait(1.5)

                -- 2. Check if we are near the pad AND alone
                if game.PlaceId == LOBBY_PLACE_ID and isAloneOnPad() then
                    print("🖱️ Alone on pad. Firing clicks instantly...")

                    -- Click Insane Difficulty
                    local difInsane = waitForPathFast(LocalPlayer, {
                        "PlayerGui", "GameGui", "Screen", "Middle",
                        "MapPickerLobby", "Items", "Frame", "Info", "Difficulty", "dif_easy"
                    })
                    if difInsane then
                        pcall(function() firesignal(difInsane.MouseButton1Click) end)
                        print("✅ Fired: Difficulty (easy)")
                    end

                    task.wait(0.3)

                    -- Click Accept
                    local acceptBtn = waitForPathFast(LocalPlayer, {
                        "PlayerGui", "GameGui", "Screen", "Middle",
                        "MapPickerLobby", "Items", "Frame", "Info", "Accept"
                    })
                    if acceptBtn then
                        pcall(function() firesignal(acceptBtn.MouseButton1Click) end)
                        print("✅ Fired: Accept")
                    end

                    task.wait(0.3)

                    -- Click Start Now
                    local startNowBtn = waitForPathFast(LocalPlayer, {
                        "PlayerGui", "GameGui", "Screen", "Bottom",
                        "Lobby", "Frame", "Buttons", "StartNow"
                    })
                    if startNowBtn then
                        pcall(function() firesignal(startNowBtn.MouseButton1Click) end)
                        print("✅ Fired: Start Now")
                    end

                    -- Wait to see if we teleported
                    task.wait(1.5)

                    -- Failsafe bounce if still in lobby
                    if game.PlaceId == LOBBY_PLACE_ID then
                        print("⚠️ Still in lobby! Bouncing to failsafe position...")
                        teleportTo(BOUNCE_POS)
                        task.wait(0.5)
                        teleportTo(JOIN_PAD_POS)
                    end
                else
                    print("❌ Another player is near the pad or we are not close enough. Bouncing...")
                    teleportTo(BOUNCE_POS)
                    task.wait(0.5)
                    teleportTo(JOIN_PAD_POS)
                    task.wait(1)
                end
            else
                task.wait(1) -- In game, just idle
            end
        end
    end)
end

